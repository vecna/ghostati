{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghostmaxxing.vecna.eu/projects/PROJECTS.schema.json",
  "title": "Ghostmaxxing complementary projects",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "last_updated", "language", "categories", "tag_definitions", "projects"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "last_updated": { "type": "string", "format": "date" },
    "language": { "type": "string", "const": "en" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "description"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "label": { "$ref": "#/$defs/text" },
          "description": { "$ref": "#/$defs/text" }
        }
      }
    },
    "tag_definitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "description": "Controlled vocabularies. `target` lists the systems a project may declare it aims at. scripts-dev/build-genealogy.py maps every target onto one row of the genealogy chart and stops on any it does not know.",
      "properties": {
        "target": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/slug" } }
      }
    },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/project" }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "text": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "pattern": "^https?://" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "url", "category", "status", "access", "year", "target", "description", "image", "links"],
      "properties": {
        "slug": { "$ref": "#/$defs/slug" },
        "name": { "$ref": "#/$defs/text" },
        "url": { "$ref": "#/$defs/url" },
        "category": { "$ref": "#/$defs/slug" },
        "status": { "enum": ["active", "archived", "unknown"] },
        "access": { "$ref": "#/$defs/slug" },
        "year": {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2100,
          "description": "Year the project was first shown in public (launch, exhibition, talk, crowdfunding or publication), not the year work started. Places the project on the genealogy chart."
        },
        "target": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/slug" },
          "description": "What the project says it aims at, from tag_definitions.target, most specific first. Decides the genealogy row and whether the mark counts as aimed at a face system."
        },
        "description": { "$ref": "#/$defs/text" },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["src", "alt", "source_url", "credit", "rights_status"],
          "properties": {
            "src": { "type": "string", "pattern": "^/images/projects/[a-z0-9-]+\\.(?:avif|jpe?g|png|webp)$" },
            "alt": { "$ref": "#/$defs/text" },
            "source_url": { "$ref": "#/$defs/url" },
            "credit": { "$ref": "#/$defs/text" },
            "rights_status": { "$ref": "#/$defs/text" }
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "url"],
            "properties": {
              "label": { "$ref": "#/$defs/text" },
              "url": { "$ref": "#/$defs/url" }
            }
          }
        }
      }
    }
  }
}
